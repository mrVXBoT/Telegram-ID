# =====================================================================
# Telegram Account Manager & Contact Extractor - Environment Config
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to version control.
# =====================================================================

# [REQUIRED] Telegram API Credentials (obtain from https://my.telegram.org)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# [REQUIRED] Telegram Bot API Token (obtain from @BotFather)
# Format: <numeric_bot_id>:<bot_secret_token>
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# [OPTIONAL] Storage Paths (relative to project root or absolute paths)
# Directory where Telethon user .session files are stored
SESSIONS_DIR=sessions

# File path for the SQLite database
DATABASE_PATH=data/bot.db

# [OPTIONAL] Logging Verbosity
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
